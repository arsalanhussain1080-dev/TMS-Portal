<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <PortalRole Condition="'$(PortalRole)' == ''">Student</PortalRole>
    <AssemblyName>TMS-$(PortalRole)</AssemblyName>
    <ApplicationIcon>$(PortalRole).ico</ApplicationIcon>
    <DefineConstants Condition="'$(PortalRole)' == 'Admin'">$(DefineConstants);TMS_ADMIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
